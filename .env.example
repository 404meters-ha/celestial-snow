# ========== GitHub ==========
# 个人访问令牌（必须）：https://github.com/settings/tokens 勾选 repo / read:user 即可
# 没有 token 时 GitHub API 限流 60 次/小时，基本不可用
GITHUB_TOKEN=

# 可选：本机代理（仅访问 github.com 网页端爬 trending 用，如 http://127.0.0.1:7890）
# 配置后自动启用"真实 trending 页面"抓取通道
GITHUB_PROXY=

# ========== LLM（GLM Coding Plan）==========
# OpenAI 兼容端点。实现接入时由使用者提供 base_url / api_key / model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7

# ========== 搜索（企业落地场景验证）==========
# 可选 provider: bocha | tavily | zai | 留空则只用 README 中明确声明案例（保守模式）
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ========== 采集与分析规模 ==========
CANDIDATE_POOL=100      # Search API 候选池大小
TOP_N_LLM=30            # 规则粗筛后进入 LLM 精析的数量
SCHED_HOUR=8            # 每日抓取分析时间（小时）

# ========== 内置 Agent SDK（技能 / AI 命令无头执行）==========
SKILL_RUN_TIMEOUT=3600          # 单次技能/agent 执行超时（秒）
PLATFORM_API_BASE=http://127.0.0.1:8100  # PlatformAPI 工具回访本服务的地址（云端部署改对外域名）

# ========== 卡奥斯 OSS（/tech 课程 HTML 发布用）==========
# 对应 Java 侧 com.cosmoplat.hyida:hyida-starter-obs —— 它底层就是 aws-java-sdk-s3，
# 本项目用 boto3 走同样的 S3 协议（path-style + us-east-1），凭据向卡奥斯平台申请。
HYIDA_OBS_ENABLED=0             # 1=启用发布；0=关闭（关闭时 /publish 返回 503）
HYIDA_OBS_ACCESS_KEY=
HYIDA_OBS_SECRET_KEY=
HYIDA_OBS_ENDPOINT=https://hd-oss.cosmoplat.com
HYIDA_OBS_BUCKET=courses        # 桶名，S3 API 用裸名
HYIDA_OBS_URL_PREFIX=hdCosmo100 # 租户前缀：公网直读地址是 {endpoint}/{URL_PREFIX}:{BUCKET}/{key}
HYIDA_OBS_URL_ACCOUNT_QUALIFIED=1  # 1=按上面形式生成公开链接（实测裸桶名地址公网 404）
HYIDA_OBS_KEY_PREFIX=           # 对象 key 一级目录；专用桶留空
HYIDA_OBS_CHECK_MAX_SIZE=0      # 对应 Java 侧 isCheckMaxSize，留空/0 即不做大小与后缀校验

# ========== 子路径部署（如 https://域名/celestial-snow/）==========
# 后端中间件剥掉请求路径里的该前缀（nginx 透传或剥前缀都兼容），
# 前端构建 base 也读它（frontend/vite.config.js）。改动后需重新构建前端。
BASE_PATH=                      # 留空 = 根路径部署（本地默认）
